{
  "name": "tafaseel-attendance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3080 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "python3 tests/test_attendance.py",
    "preview:prepare": "python3 scripts/prepare_preview.py",
    "package": "python3 scripts/package.py",
    "start": "python3 scripts/dev.py",
    "build:demo": "tsc --noEmit && VITE_STATIC_DEMO=1 vite build --base=/tafaseel-attendance/ && python3 scripts/prepare_pages.py",
    "test:demo": "node --test tests/demo.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
